{
  "$id": "https://schemas.yeisme.dev/audio/podcast-narration-delivery/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "narration_body": {
      "minLength": 1,
      "type": "string"
    },
    "performance_marks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "podcast_narration_delivery.v1"
    },
    "uncertain_pronunciations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "narration_body",
    "schema_version"
  ],
  "type": "object"
}
