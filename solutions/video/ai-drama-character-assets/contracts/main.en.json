{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "video",
  "solution_id": "ai-drama-character-assets",
  "version": "1.0.0",
  "role": "main",
  "locale": "en",
  "template_path": "solutions/video/ai-drama-character-assets/prompts/main.en.md",
  "template_digest": "sha256:15980850c877b6b93dcdf52b4214f7280d1b1056ef865e90ecc1459602f1964c",
  "digest": "sha256:daf5bfe9456013390c5dd9f0eb1b84cd59ac0ae14b6b1a3482c6306d8ea5e0e0",
  "license": "internal",
  "permissions": [
    "execute_requires_review",
    "inspect",
    "preview"
  ],
  "inputs": [
    {
      "name": "asset_profile_id",
      "type": "enum",
      "required": true,
      "enum": [
        "face-master-v1",
        "body-master-v1",
        "turnaround-three-view-v1",
        "wardrobe-sheet-v1",
        "expression-sheet-v1",
        "action-sheet-v1",
        "prop-scene-sheet-v1",
        "shot-keyframe-v1",
        "continuity-repair-v1"
      ],
      "labels": {
        "en": "Asset profile"
      },
      "descriptions": {
        "en": "Controls the visual asset type and its specialized quality gates"
      },
      "sensitivity": "public"
    },
    {
      "name": "continuity_constraints_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 262144,
      "labels": {
        "en": "Continuity constraints"
      },
      "descriptions": {
        "en": "Facts that must remain stable across views and shots, serialized as JSON"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "locale",
      "type": "enum",
      "required": true,
      "enum": [
        "en"
      ],
      "labels": {
        "en": "Locale"
      },
      "descriptions": {
        "en": "Language used by the Prompt body and output text"
      },
      "sensitivity": "public"
    },
    {
      "name": "output_schema_version",
      "type": "enum",
      "required": true,
      "enum": [
        "character_asset.prompt_bundle.v1"
      ],
      "labels": {
        "en": "Output schema version"
      },
      "descriptions": {
        "en": "Prompt Bundle output schema version"
      },
      "sensitivity": "public"
    },
    {
      "name": "reference_bindings_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 524288,
      "labels": {
        "en": "Reference bindings"
      },
      "descriptions": {
        "en": "Reference bindings with role, version, state, and permission, serialized as JSON"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "schema_version",
      "type": "enum",
      "required": true,
      "enum": [
        "eikona.character_asset_prompt_input.v1"
      ],
      "labels": {
        "en": "Input schema version"
      },
      "descriptions": {
        "en": "Visual asset Prompt input envelope version"
      },
      "sensitivity": "public"
    },
    {
      "name": "style_lens_summary",
      "type": "string",
      "required": true,
      "min_length": 0,
      "max_length": 8192,
      "labels": {
        "en": "Style lens summary"
      },
      "descriptions": {
        "en": "Original dimensional visual constraints without a persona identity"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "subject_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 262144,
      "labels": {
        "en": "Subject data"
      },
      "descriptions": {
        "en": "Validated identity, body, and stable-feature data serialized as JSON"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "subject_version_ref",
      "type": "string",
      "required": true,
      "examples": [
        "subject:wuxia-lan-01@v1"
      ],
      "regex": "^[A-Za-z0-9][A-Za-z0-9:._/@-]{0,255}$",
      "min_length": 1,
      "max_length": 256,
      "labels": {
        "en": "Subject version ref"
      },
      "descriptions": {
        "en": "Exact subject version reference supplied by the visual asset owner"
      },
      "sensitivity": "public"
    },
    {
      "name": "task_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 262144,
      "labels": {
        "en": "Generation task"
      },
      "descriptions": {
        "en": "Asset type, layout, views, aspect ratio, and quality gates serialized as JSON"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "wardrobe_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 262144,
      "labels": {
        "en": "Wardrobe data"
      },
      "descriptions": {
        "en": "Validated wardrobe layers, materials, and coverage relations serialized as JSON"
      },
      "sensitivity": "sensitive"
    }
  ]
}
