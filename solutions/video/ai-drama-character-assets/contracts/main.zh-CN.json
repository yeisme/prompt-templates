{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "video",
  "solution_id": "ai-drama-character-assets",
  "version": "1.0.0",
  "role": "main",
  "locale": "zh-CN",
  "template_path": "solutions/video/ai-drama-character-assets/prompts/main.zh-CN.md",
  "template_digest": "sha256:8585320f1bfab00de5a9840aea6b0bcf5d4fbdc19d1ec178b235a42c5706c6af",
  "digest": "sha256:9a37726eac9c6995afe627911e6b13d51723646e5aa6d81110d83a2caf6704ed",
  "license": "internal",
  "permissions": [
    "execute_requires_review",
    "inspect",
    "preview"
  ],
  "inputs": [
    {
      "name": "asset_profile_id",
      "type": "enum",
      "required": true,
      "enum": [
        "face-master-v1",
        "body-master-v1",
        "turnaround-three-view-v1",
        "wardrobe-sheet-v1",
        "expression-sheet-v1",
        "action-sheet-v1",
        "prop-scene-sheet-v1",
        "shot-keyframe-v1",
        "continuity-repair-v1"
      ],
      "labels": {
        "zh-CN": "资产预设"
      },
      "descriptions": {
        "zh-CN": "控制视觉资产类型和专用质量门"
      },
      "sensitivity": "public"
    },
    {
      "name": "continuity_constraints_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 262144,
      "labels": {
        "zh-CN": "连续性约束"
      },
      "descriptions": {
        "zh-CN": "需要跨视图和镜头保持的事实 JSON"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "locale",
      "type": "enum",
      "required": true,
      "enum": [
        "zh-CN"
      ],
      "labels": {
        "zh-CN": "语言区域"
      },
      "descriptions": {
        "zh-CN": "Prompt 正文与输出文本语言"
      },
      "sensitivity": "public"
    },
    {
      "name": "output_schema_version",
      "type": "enum",
      "required": true,
      "enum": [
        "character_asset.prompt_bundle.v1"
      ],
      "labels": {
        "zh-CN": "输出结构版本"
      },
      "descriptions": {
        "zh-CN": "Prompt Bundle 输出结构版本"
      },
      "sensitivity": "public"
    },
    {
      "name": "reference_bindings_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 524288,
      "labels": {
        "zh-CN": "参考绑定"
      },
      "descriptions": {
        "zh-CN": "带 role、版本、状态和权限的参考绑定 JSON"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "schema_version",
      "type": "enum",
      "required": true,
      "enum": [
        "eikona.character_asset_prompt_input.v1"
      ],
      "labels": {
        "zh-CN": "输入结构版本"
      },
      "descriptions": {
        "zh-CN": "视觉资产Prompt输入信封版本"
      },
      "sensitivity": "public"
    },
    {
      "name": "style_lens_summary",
      "type": "string",
      "required": true,
      "min_length": 0,
      "max_length": 8192,
      "labels": {
        "zh-CN": "风格镜片摘要"
      },
      "descriptions": {
        "zh-CN": "原创维度化视觉约束，不含 persona 身份"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "subject_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 262144,
      "labels": {
        "zh-CN": "主体数据"
      },
      "descriptions": {
        "zh-CN": "已校验的身份、身体和稳定特征 JSON"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "subject_version_ref",
      "type": "string",
      "required": true,
      "examples": [
        "subject:wuxia-lan-01@v1"
      ],
      "regex": "^[A-Za-z0-9][A-Za-z0-9:._/@-]{0,255}$",
      "min_length": 1,
      "max_length": 256,
      "labels": {
        "zh-CN": "主体版本引用"
      },
      "descriptions": {
        "zh-CN": "由视觉资产 owner 提供的 exact 主体版本引用"
      },
      "sensitivity": "public"
    },
    {
      "name": "task_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 262144,
      "labels": {
        "zh-CN": "生成任务"
      },
      "descriptions": {
        "zh-CN": "资产类型、布局、视图、画幅和质量门 JSON"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "wardrobe_json",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 262144,
      "labels": {
        "zh-CN": "服装数据"
      },
      "descriptions": {
        "zh-CN": "已校验的服装层级、材料和覆盖关系 JSON"
      },
      "sensitivity": "sensitive"
    }
  ]
}
