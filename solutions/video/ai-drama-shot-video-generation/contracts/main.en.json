      },
      "sensitivity": "public"
    },
    {
      "name": "quality_profile",
      "type": "string",
      "required": true,
      "examples": [
        "UE5.4 Path Tracing，Lumen全局光照，8K分辨率，60fps，12bit HDR1500，PBR物理材质渲染，35mm Kodak 5219胶片颗粒45%"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Quality profile",
        "zh-CN": "画质与渲染规格"
      },
      "descriptions": {
        "en": "Rendering engine, resolution, frame rate, HDR, film grain and other quality specs",
        "zh-CN": "渲染引擎、分辨率、帧率、HDR、胶片颗粒等整块画质规格描述"
      },
      "sensitivity": "public"
    },
    {
      "name": "release_phase_rule",
      "type": "string",
      "required": true,
      "examples": [
        "爆发后允许落地收剑、冷酷定格站立"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Release-phase rule",
        "zh-CN": "爆发与收尾期行为约束"
      },
      "descriptions": {
        "en": "Actions allowed in the release and finale phase",
        "zh-CN": "爆发与收尾阶段允许的动作，如落地收剑定格"
      },
      "sensitivity": "public"
    },
