{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "video",
  "solution_id": "ai-drama-shot-video-generation",
  "version": "1.0.0",
  "role": "main",
  "locale": "en",
  "template_path": "solutions/video/ai-drama-shot-video-generation/prompts/main.en.md",
  "template_digest": "sha256:409707a917987bceb952de011a8d1b91c6acf7a99f65f55a7bfdb75e8250a04f",
  "digest": "sha256:7141ee2a5591de3fb49de687a863d927c19b79d3e081f1d7f99b69a34c3f1470",
  "license": "internal",
  "permissions": [
    "execute_requires_review",
    "inspect",
    "preview"
  ],
  "inputs": [
    {
      "name": "aspect_ratio",
      "type": "enum",
      "default": "16:9",
      "enum": [
        "16:9",
        "9:16",
        "1:1",
        "2.39:1"
      ],
      "labels": {
        "en": "Aspect ratio",
        "zh-CN": "画幅比例"
      },
      "descriptions": {
        "en": "Output aspect ratio",
        "zh-CN": "输出视频画幅"
      },
      "sensitivity": "public"
    },
    {
      "name": "camera_spec",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Camera spec",
        "zh-CN": "运镜规格总纲"
      },
      "descriptions": {
        "en": "Cut cadence, transition whitelist, handheld parameters, impact-frame grading",
        "zh-CN": "镜头切换节奏、转场白名单、手持参数与冲击帧分级"
      },
      "sensitivity": "public"
    },
    {
      "name": "character_core",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Character core behavior",
        "zh-CN": "角色核心行为设定"
      },
      "descriptions": {
        "en": "Core behavior and positioning for the whole video",
        "zh-CN": "角色全片的核心行为与站位设定"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "character_label",
      "type": "string",
      "required": true,
      "examples": [
        "角色A（女帝）"
      ],
      "min_length": 2,
      "max_length": 128,
      "labels": {
        "en": "Character label",
        "zh-CN": "角色标识"
      },
      "descriptions": {
        "en": "How the character is addressed in the prompt",
        "zh-CN": "角色在 Prompt 中的称呼"
      },
      "sensitivity": "public"
    },
    {
      "name": "character_ref",
      "type": "string",
      "required": true,
      "examples": [
        "@ef946113-3379-4497-86e6-4dc529266c1d"
      ],
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 2,
      "max_length": 256,
      "labels": {
        "en": "Character asset ref",
        "zh-CN": "角色资产引用"
      },
      "descriptions": {
        "en": "Registered character asset @-reference; never invent",
        "zh-CN": "已登记角色资产的 @ 引用，禁止编造"
      },
      "sensitivity": "public"
    },
    {
      "name": "charge_phase_rule",
      "type": "string",
      "required": true,
      "examples": [
        "蓄力期间全程悬空施法，绝不落地、零站桩、零停顿"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Charge-phase rule",
        "zh-CN": "蓄力期行为约束"
      },
      "descriptions": {
        "en": "Behavior red lines during the charge phase",
        "zh-CN": "蓄力阶段角色的行为红线，如全程悬空、绝不落地"
      },
      "sensitivity": "public"
    },
    {
      "name": "color_grading",
      "type": "string",
      "required": true,
      "examples": [
        "色彩空间Rec.2020，暗部偏幽紫，高光偏黑金"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Color grading",
        "zh-CN": "色彩与影调"
      },
      "descriptions": {
        "en": "Color space and shadow/highlight tint",
        "zh-CN": "色彩空间、暗部与高光色调倾向"
      },
      "sensitivity": "public"
    },
    {
      "name": "duration_s",
      "type": "integer",
      "required": true,
      "default": 30,
      "examples": [
        30
      ],
      "min": 5,
      "max": 120,
      "labels": {
        "en": "Duration (s)",
        "zh-CN": "总时长（秒）"
      },
      "descriptions": {
        "en": "Total duration; the storyboard must cover it continuously",
        "zh-CN": "镜头总时长，分镜表必须连续覆盖"
      },
      "sensitivity": "public"
    },
    {
      "name": "effect_mix",
      "type": "string",
      "required": true,
      "examples": [
        "能量体60% + 水墨20% + 流体20%"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Effect mix",
        "zh-CN": "特效配比"
      },
      "descriptions": {
        "en": "Effect types and ratio description",
        "zh-CN": "能量体/水墨/流体等特效类型与占比描述"
      },
      "sensitivity": "public"
    },
    {
      "name": "enemy_counterattack",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Enemy counterattack",
        "zh-CN": "敌方反击模式"
      },
      "descriptions": {
        "en": "Enemy counterattack patterns during the charge phase",
        "zh-CN": "蓄力期敌方的反击手段与强度"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "enemy_death_reaction",
      "type": "string",
      "required": true,
      "examples": [
        "被绞碎时喷发魂火痛苦抽搐，灰飞烟灭前发出凄厉惨叫，最后化为紫黑冥烬"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Enemy death reaction",
        "zh-CN": "敌方死亡反应"
      },
      "descriptions": {
        "en": "Protocol-compliant hit and death representation",
        "zh-CN": "符合安全协议的受击与消亡表现"
      },
      "sensitivity": "public"
    },
    {
      "name": "enemy_desc",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Enemy group description",
        "zh-CN": "敌方群组描述"
      },
      "descriptions": {
        "en": "Enemy group composition and entrance",
        "zh-CN": "敌方群体构成与出场方式"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "enemy_ref",
      "type": "string",
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "en": "Enemy asset ref",
        "zh-CN": "敌方资产引用"
      },
      "descriptions": {
        "en": "Registered enemy asset @-reference; required when an asset exists",
        "zh-CN": "已登记敌方资产的 @ 引用；有对应资产时必填"
      },
      "sensitivity": "public"
    },
    {
      "name": "gore_protocol",
      "type": "string",
      "required": true,
      "examples": [
        "ZeroBlood协议：严禁任何血液、断肢，受击全由粒子特效替代"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Gore protocol",
        "zh-CN": "安全协议"
      },
      "descriptions": {
        "en": "Replacement-representation protocol for gore content",
        "zh-CN": "血液/断肢等敏感内容的替代表现协议"
      },
      "sensitivity": "public"
    },
    {
      "name": "max_actions_per_second",
      "type": "integer",
      "required": true,
      "default": 3,
      "examples": [
        3
      ],
      "min": 1,
      "max": 5,
      "labels": {
        "en": "Max actions per second",
        "zh-CN": "单秒动作上限"
      },
      "descriptions": {
        "en": "Maximum actions allowed per second; anti-break hard constraint",
        "zh-CN": "每秒钟允许的最大动作数，防崩硬约束"
      },
      "sensitivity": "public"
    },
    {
      "name": "negative_prompts",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 8192,
      "labels": {
        "en": "Negative prompts",
        "zh-CN": "负面提示词"
      },
      "descriptions": {
        "en": "Negative constraint list; template defaults are merged",
        "zh-CN": "负面约束清单；模板内置默认负面项会并入"
      },
      "sensitivity": "public"
    },
    {
      "name": "provider_banner",
      "type": "string",
      "examples": [
        "Made with Seedance 2.5"
      ],
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "en": "Provider banner",
        "zh-CN": "平台标识行"
      },
      "descriptions": {
        "en": "Optional delivery-platform banner line rendered at the top; omitted when empty",
