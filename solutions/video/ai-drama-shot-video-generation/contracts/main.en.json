      "name": "scene_anchors",
      "type": "string",
      "required": true,
      "examples": [
        "残破战车、断裂战旗、古战场白骨"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Scene geometry anchors",
        "zh-CN": "场景几何锚点"
      },
      "descriptions": {
        "en": "Rigid scene elements that must stay recognizable",
        "zh-CN": "全片必须保持可辨识的刚性场景元素"
      },
      "sensitivity": "public"
    },
    {
      "name": "scene_desc",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Scene description",
        "zh-CN": "场景描述"
      },
      "descriptions": {
        "en": "Scene atmosphere and environment",
        "zh-CN": "场景氛围与环境描述"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "scene_ref",
      "type": "string",
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "en": "Scene asset ref",
        "zh-CN": "场景资产引用"
      },
      "descriptions": {
        "en": "Registered scene asset @-reference; required when an asset exists",
        "zh-CN": "已登记场景资产的 @ 引用；有对应资产时必填"
      },
      "sensitivity": "public"
    },
    {
      "name": "shot_list",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 65536,
      "labels": {
        "en": "Shot list",
        "zh-CN": "逐镜头分镜表"
      },
      "descriptions": {
        "en": "Shot-by-shot instructions in the slot structure; continuous time coverage",
        "zh-CN": "按分镜槽位结构编写的逐镜头指令，时间区间连续覆盖全片"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "style_keywords",
      "type": "string",
      "required": true,
      "examples": [
        "顶级院线级真人特效大电影风格，真人实拍电影质感，次世代超写实，废土修仙融合"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Style keywords",
        "zh-CN": "风格关键词"
      },
      "descriptions": {
        "en": "Overall art-style keyword set",
        "zh-CN": "整体美术风格关键词组合"
      },
      "sensitivity": "public"
    },
    {
      "name": "ultimate_skill_name",
      "type": "string",
      "required": true,
      "examples": [
        "冥狱剑仙阵"
      ],
      "min_length": 2,
      "max_length": 128,
      "labels": {
        "en": "Ultimate skill name",
        "zh-CN": "终极技名称"
      },
      "descriptions": {
        "en": "Name of the ultimate skill",
        "zh-CN": "大招名称"
      },
      "sensitivity": "public"
    },
    {
      "name": "ultimate_skill_visual",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Ultimate skill visual",
        "zh-CN": "终极技核心视觉"
      },
      "descriptions": {
        "en": "Core visuals and charge-release mechanics of the skill",
        "zh-CN": "法阵/符咒/飞剑等核心视觉与蓄力-爆发机制描述"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "wardrobe_anchors",
      "type": "string",
      "required": true,
      "examples": [
        "橘红围巾、土黄长裙"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Wardrobe anchors",
        "zh-CN": "外观锚点"
      },
      "descriptions": {
        "en": "Wardrobe/appearance features that must not clip or vanish",
        "zh-CN": "需要防穿模/防丢失的服装与外观特征清单"
