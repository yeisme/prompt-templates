    {
      "name": "weapon_desc",
      "type": "string",
      "examples": [
        "长剑（通体黑金色，刃口流淌紫黑色深渊剑气）"
      ],
      "min_length": 0,
      "max_length": 2048,
      "labels": {
        "en": "Weapon description",
        "zh-CN": "武器描述"
      },
      "descriptions": {
        "en": "Weapon appearance and effect; may be empty for weapon-free shots",
        "zh-CN": "武器外观与特效描述；无武器镜头可留空"
      },
      "sensitivity": "public"
    },
    {
      "name": "weapon_ref",
      "type": "string",
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "en": "Weapon asset ref",
        "zh-CN": "武器资产引用"
      },
      "descriptions": {
        "en": "Registered weapon asset @-reference; required when a weapon asset exists",
