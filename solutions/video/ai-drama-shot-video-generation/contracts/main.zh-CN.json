{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "video",
  "solution_id": "ai-drama-shot-video-generation",
  "version": "1.0.0",
  "role": "main",
  "locale": "zh-CN",
  "template_path": "solutions/video/ai-drama-shot-video-generation/prompts/main.zh-CN.md",
  "template_digest": "sha256:10f7a558ae308e21a3d0d2f2bbd56f5d8aed32d5f85aaddd2ee1fad6a4e19a72",
  "digest": "sha256:df6dbb6b8edc07106ea01f3bee9bd1bfd4285cd0744d63114198a583cd750cef",
  "license": "internal",
  "permissions": [
    "execute_requires_review",
    "inspect",
    "preview"
  ],
  "inputs": [
    {
      "name": "aspect_ratio",
      "type": "enum",
      "default": "16:9",
      "enum": [
        "16:9",
        "9:16",
        "1:1",
        "2.39:1"
      ],
      "labels": {
        "zh-CN": "画幅比例"
      },
      "descriptions": {
        "zh-CN": "输出视频画幅"
      },
      "sensitivity": "public"
    },
    {
      "name": "camera_spec",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "运镜规格总纲"
      },
      "descriptions": {
        "zh-CN": "镜头切换节奏、转场白名单、手持参数与冲击帧分级"
      },
      "sensitivity": "public"
    },
    {
      "name": "character_core",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "角色核心行为设定"
      },
      "descriptions": {
        "zh-CN": "角色全片的核心行为与站位设定"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "character_label",
      "type": "string",
      "required": true,
      "examples": [
        "角色A（女帝）"
      ],
      "min_length": 2,
      "max_length": 128,
      "labels": {
        "zh-CN": "角色标识"
      },
      "descriptions": {
        "zh-CN": "角色在 Prompt 中的称呼"
      },
      "sensitivity": "public"
    },
    {
      "name": "character_ref",
      "type": "string",
      "required": true,
      "examples": [
        "@ef946113-3379-4497-86e6-4dc529266c1d"
      ],
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 2,
      "max_length": 256,
      "labels": {
        "zh-CN": "角色资产引用"
      },
      "descriptions": {
        "zh-CN": "已登记角色资产的 @ 引用，禁止编造"
      },
      "sensitivity": "public"
    },
    {
      "name": "charge_phase_rule",
      "type": "string",
      "required": true,
      "examples": [
        "蓄力期间全程悬空施法，绝不落地、零站桩、零停顿"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "蓄力期行为约束"
      },
      "descriptions": {
        "zh-CN": "蓄力阶段角色的行为红线，如全程悬空、绝不落地"
      },
      "sensitivity": "public"
    },
    {
      "name": "color_grading",
      "type": "string",
      "required": true,
      "examples": [
        "色彩空间Rec.2020，暗部偏幽紫，高光偏黑金"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "zh-CN": "色彩与影调"
      },
      "descriptions": {
        "zh-CN": "色彩空间、暗部与高光色调倾向"
      },
      "sensitivity": "public"
    },
    {
      "name": "duration_s",
      "type": "integer",
      "required": true,
      "default": 30,
      "examples": [
        30
      ],
      "min": 5,
      "max": 120,
      "labels": {
        "zh-CN": "总时长（秒）"
      },
      "descriptions": {
        "zh-CN": "镜头总时长，分镜表必须连续覆盖"
      },
      "sensitivity": "public"
    },
    {
      "name": "effect_mix",
      "type": "string",
      "required": true,
      "examples": [
        "能量体60% + 水墨20% + 流体20%"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "zh-CN": "特效配比"
      },
      "descriptions": {
        "zh-CN": "能量体/水墨/流体等特效类型与占比描述"
      },
      "sensitivity": "public"
    },
    {
      "name": "enemy_counterattack",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "敌方反击模式"
      },
      "descriptions": {
        "zh-CN": "蓄力期敌方的反击手段与强度"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "enemy_death_reaction",
      "type": "string",
      "required": true,
      "examples": [
        "被绞碎时喷发魂火痛苦抽搐，灰飞烟灭前发出凄厉惨叫，最后化为紫黑冥烬"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "敌方死亡反应"
      },
      "descriptions": {
        "zh-CN": "符合安全协议的受击与消亡表现"
      },
      "sensitivity": "public"
    },
    {
      "name": "enemy_desc",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "敌方群组描述"
      },
      "descriptions": {
        "zh-CN": "敌方群体构成与出场方式"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "enemy_ref",
      "type": "string",
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "zh-CN": "敌方资产引用"
      },
      "descriptions": {
        "zh-CN": "已登记敌方资产的 @ 引用；有对应资产时必填"
      },
      "sensitivity": "public"
    },
    {
      "name": "gore_protocol",
      "type": "string",
      "required": true,
      "examples": [
        "ZeroBlood协议：严禁任何血液、断肢，受击全由粒子特效替代"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "zh-CN": "安全协议"
      },
      "descriptions": {
        "zh-CN": "血液/断肢等敏感内容的替代表现协议"
      },
      "sensitivity": "public"
    },
    {
      "name": "max_actions_per_second",
      "type": "integer",
      "required": true,
      "default": 3,
      "examples": [
        3
      ],
      "min": 1,
      "max": 5,
      "labels": {
        "zh-CN": "单秒动作上限"
      },
      "descriptions": {
        "zh-CN": "每秒钟允许的最大动作数，防崩硬约束"
      },
      "sensitivity": "public"
    },
    {
      "name": "negative_prompts",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 8192,
      "labels": {
        "zh-CN": "负面提示词"
      },
      "descriptions": {
        "zh-CN": "负面约束清单；模板内置默认负面项会并入"
      },
      "sensitivity": "public"
    },
    {
      "name": "quality_profile",
      "type": "string",
      "required": true,
      "examples": [
        "UE5.4 Path Tracing，Lumen全局光照，8K分辨率，60fps，12bit HDR1500，PBR物理材质渲染，35mm Kodak 5219胶片颗粒45%"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "画质与渲染规格"
      },
      "descriptions": {
        "zh-CN": "渲染引擎、分辨率、帧率、HDR、胶片颗粒等整块画质规格描述"
      },
      "sensitivity": "public"
    },
    {
      "name": "release_phase_rule",
      "type": "string",
      "required": true,
      "examples": [
        "爆发后允许落地收剑、冷酷定格站立"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "爆发与收尾期行为约束"
      },
      "descriptions": {
        "zh-CN": "爆发与收尾阶段允许的动作，如落地收剑定格"
      },
      "sensitivity": "public"
    },
    {
      "name": "scene_anchors",
      "type": "string",
      "required": true,
      "examples": [
        "残破战车、断裂战旗、古战场白骨"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "zh-CN": "场景几何锚点"
      },
      "descriptions": {
        "zh-CN": "全片必须保持可辨识的刚性场景元素"
      },
      "sensitivity": "public"
    },
    {
      "name": "scene_desc",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "场景描述"
      },
      "descriptions": {
        "zh-CN": "场景氛围与环境描述"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "scene_ref",
      "type": "string",
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "zh-CN": "场景资产引用"
      },
      "descriptions": {
        "zh-CN": "已登记场景资产的 @ 引用；有对应资产时必填"
      },
      "sensitivity": "public"
    },
    {
      "name": "shot_list",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 65536,
      "labels": {
        "zh-CN": "逐镜头分镜表"
      },
      "descriptions": {
        "zh-CN": "按分镜槽位结构编写的逐镜头指令，时间区间连续覆盖全片"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "style_keywords",
      "type": "string",
      "required": true,
      "examples": [
        "顶级院线级真人特效大电影风格，真人实拍电影质感，次世代超写实，废土修仙融合"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "zh-CN": "风格关键词"
      },
      "descriptions": {
        "zh-CN": "整体美术风格关键词组合"
      },
      "sensitivity": "public"
    },
    {
      "name": "ultimate_skill_name",
      "type": "string",
      "required": true,
      "examples": [
        "冥狱剑仙阵"
      ],
      "min_length": 2,
      "max_length": 128,
      "labels": {
        "zh-CN": "终极技名称"
      },
      "descriptions": {
        "zh-CN": "大招名称"
      },
      "sensitivity": "public"
    },
    {
      "name": "ultimate_skill_visual",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "zh-CN": "终极技核心视觉"
      },
      "descriptions": {
        "zh-CN": "法阵/符咒/飞剑等核心视觉与蓄力-爆发机制描述"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "wardrobe_anchors",
      "type": "string",
      "required": true,
      "examples": [
        "橘红围巾、土黄长裙"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "zh-CN": "外观锚点"
      },
      "descriptions": {
        "zh-CN": "需要防穿模/防丢失的服装与外观特征清单"
      },
      "sensitivity": "public"
    },
    {
      "name": "weapon_desc",
      "type": "string",
      "examples": [
        "长剑（通体黑金色，刃口流淌紫黑色深渊剑气）"
      ],
      "min_length": 0,
      "max_length": 2048,
      "labels": {
        "zh-CN": "武器描述"
      },
      "descriptions": {
        "zh-CN": "武器外观与特效描述；无武器镜头可留空"
      },
      "sensitivity": "public"
    },
    {
      "name": "weapon_ref",
      "type": "string",
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "zh-CN": "武器资产引用"
      },
      "descriptions": {
        "zh-CN": "已登记武器资产的 @ 引用；有武器资产时必填"
      },
      "sensitivity": "public"
    }
  ]
}
