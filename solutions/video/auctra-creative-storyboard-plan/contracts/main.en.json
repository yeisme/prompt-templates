{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "video",
  "solution_id": "auctra-creative-storyboard-plan",
  "version": "1.0.0",
  "role": "main",
  "locale": "en",
  "template_path": "solutions/video/auctra-creative-storyboard-plan/prompts/main.en.md",
