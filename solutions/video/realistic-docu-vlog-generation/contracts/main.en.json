{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "video",
  "solution_id": "realistic-docu-vlog-generation",
  "version": "1.0.0",
  "role": "main",
  "locale": "en",
  "template_path": "solutions/video/realistic-docu-vlog-generation/prompts/main.en.md",
  "template_digest": "sha256:cf861d1747c61a5604efc645d7b3b440f0cc140859b7f3c92d012d6939e6f013",
  "digest": "sha256:d6d4510e6bf37e191ac4152d38ba9c67c3750d6d917359f2baf49ed7f51e0853",
  "license": "internal",
  "permissions": [
    "execute_requires_review",
    "inspect",
    "preview"
  ],
  "inputs": [
    {
      "name": "ambience_design",
      "type": "string",
      "required": true,
      "examples": [
        "房间、公寓、车辆、后台与人群的自然声音"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Location ambience",
        "zh-CN": "现场环境声"
      },
      "descriptions": {
        "en": "Natural location sound list per environment",
        "zh-CN": "各环境的自然现场声清单"
      },
      "sensitivity": "public"
    },
    {
      "name": "aspect_ratio",
      "type": "enum",
      "default": "16:9",
      "enum": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "labels": {
        "en": "Aspect ratio",
        "zh-CN": "画幅比例"
      },
      "descriptions": {
        "en": "Output aspect ratio",
        "zh-CN": "输出视频画幅"
      },
      "sensitivity": "public"
    },
    {
      "name": "audio_exclusions",
      "type": "string",
      "required": true,
      "examples": [
        "无音效堆砌、无罐头掌声、无字幕配音"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Audio prohibitions",
        "zh-CN": "声音禁止项"
      },
      "descriptions": {
        "en": "Banned audio elements",
        "zh-CN": "禁止的声音元素"
      },
      "sensitivity": "public"
    },
    {
      "name": "camera_exclusions",
      "type": "string",
      "required": true,
      "examples": [
        "无稳定器、无人机、不可能的机位运动与精致商业广告质感"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Camera prohibitions",
        "zh-CN": "拍摄禁止项"
      },
      "descriptions": {
        "en": "Banned camera techniques",
        "zh-CN": "禁止的拍摄手法"
      },
      "sensitivity": "public"
    },
    {
      "name": "camera_formats",
      "type": "string",
      "required": true,
      "examples": [
        "手持 DV 跟拍 + 不完美自拍 + 自然固定机位"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Camera formats",
        "zh-CN": "混合机位声明"
      },
      "descriptions": {
        "en": "Allowed capture format set, e.g. handheld DV, selfies, locked-off shots",
        "zh-CN": "全片允许的拍摄格式集合，如手持 DV、自拍、固定机位"
      },
      "sensitivity": "public"
    },
    {
      "name": "camera_imperfections",
      "type": "string",
      "required": true,
      "examples": [
        "真实手抖、自动对焦犹豫、轻微运动模糊、曝光漂移、构图不完美"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Camera imperfections",
        "zh-CN": "不完美质感"
      },
      "descriptions": {
        "en": "Authentic capture flaws that must be preserved",
        "zh-CN": "必须保留的真实拍摄瑕疵"
      },
      "sensitivity": "public"
    },
    {
      "name": "character_ref",
      "type": "string",
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "en": "Character asset ref",
        "zh-CN": "人物资产引用"
      },
      "descriptions": {
        "en": "Registered character asset @-reference; @uuid and positional refs accepted",
        "zh-CN": "已登记人物资产的 @ 引用，支持 @uuid 与 @image1 位置引用；有资产时必填"
      },
      "sensitivity": "public"
    },
    {
      "name": "consistency_lock",
      "type": "string",
      "required": true,
      "examples": [
        "全片保持完全一致的面部身份、发型与外观"
      ],
      "min_length": 10,
      "max_length": 2048,
      "labels": {
        "en": "Consistency lock",
        "zh-CN": "一致性锁定"
      },
      "descriptions": {
        "en": "Non-negotiable identity/face/hairstyle/body/wardrobe lock",
        "zh-CN": "全片不可放宽的身份/面部/发型/体型/服装锁定声明"
      },
      "sensitivity": "public"
    },
    {
      "name": "duration_s",
      "type": "integer",
      "required": true,
      "default": 30,
      "examples": [
        30
      ],
      "min": 5,
      "max": 120,
      "labels": {
        "en": "Duration (s)",
        "zh-CN": "总时长（秒）"
      },
      "descriptions": {
        "en": "Total duration; the timeline must cover it continuously",
        "zh-CN": "视频总时长，时间线必须连续覆盖"
      },
      "sensitivity": "public"
    },
    {
      "name": "ending_directive",
      "type": "string",
      "required": true,
      "examples": [
        "音乐达到高潮，强光充满画面，切黑"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Ending directive",
        "zh-CN": "结尾指令"
      },
      "descriptions": {
        "en": "How the video ends",
        "zh-CN": "结尾执行方式"
      },
      "sensitivity": "public"
    },
    {
      "name": "era_aesthetic",
      "type": "string",
      "required": true,
      "examples": [
        "千禧年初消费级 DV 质感"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Era aesthetic",
        "zh-CN": "年代质感"
      },
      "descriptions": {
        "en": "Era and device texture, e.g. early-2000s consumer DV",
        "zh-CN": "年代与设备质感，如千禧年初消费级 DV"
      },
      "sensitivity": "public"
    },
    {
      "name": "final_feel",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 2048,
      "labels": {
        "en": "Final feel",
        "zh-CN": "最终气质"
      },
      "descriptions": {
        "en": "Overall feel declaration of the final footage",
        "zh-CN": "成片整体气质声明"
      },
      "sensitivity": "public"
    },
    {
      "name": "footage_style",
      "type": "string",
      "required": true,
      "examples": [
        "photorealistic live-action video"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Footage style",
        "zh-CN": "影像风格声明"
      },
      "descriptions": {
        "en": "Overall footage style declaration",
        "zh-CN": "整体影像气质声明"
      },
      "sensitivity": "public"
    },
    {
      "name": "music_arc",
      "type": "string",
      "required": true,
      "examples": [
        "音乐逐渐推进为充满能量的现代流行曲，在结尾拍达到高潮"
      ],
      "min_length": 4,
      "max_length": 4096,
      "labels": {
        "en": "Music arc",
        "zh-CN": "音乐弧线"
      },
      "descriptions": {
        "en": "Score progression and climax",
        "zh-CN": "配乐的起承转合与终点"
      },
      "sensitivity": "public"
    },
    {
      "name": "negative_prompts",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 8192,
      "labels": {
        "en": "Negative prompts",
        "zh-CN": "负面提示词"
      },
      "descriptions": {
        "en": "Negative constraint list; template defaults are merged",
        "zh-CN": "负面约束清单；模板内置默认负面项会并入"
      },
      "sensitivity": "public"
    },
    {
      "name": "provider_banner",
      "type": "string",
      "examples": [
        "Made with Seedance 2.5"
      ],
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "en": "Provider banner",
        "zh-CN": "平台标识行"
      },
      "descriptions": {
        "en": "Optional delivery-platform banner line rendered at the top; omitted when empty",
        "zh-CN": "可选的投递平台标识行，渲染在 Prompt 顶部；留空则省略"
      },
      "sensitivity": "public"
    },
    {
      "name": "realism_rules",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Realism rules",
        "zh-CN": "写实约束"
      },
      "descriptions": {
        "en": "Anatomy, physics, lighting and material realism requirements",
        "zh-CN": "解剖、物理、光影、材质等写实要求"
      },
      "sensitivity": "public"
    },
    {
      "name": "resolution",
      "type": "enum",
      "default": "1080p",
      "enum": [
        "720p",
        "1080p",
        "4K"
      ],
      "labels": {
        "en": "Resolution",
        "zh-CN": "分辨率"
      },
      "descriptions": {
        "en": "Output video resolution",
        "zh-CN": "输出视频分辨率"
      },
      "sensitivity": "public"
    },
    {
      "name": "scenario_summary",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 2048,
      "labels": {
        "en": "Story summary",
        "zh-CN": "故事梗概"
      },
      "descriptions": {
        "en": "One-line summary of who documents what day",
        "zh-CN": "一句话说明谁在哪一天做什么"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "story_beats",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 65536,
      "labels": {
        "en": "Story beats",
        "zh-CN": "故事时间线"
      },
      "descriptions": {
        "en": "Beat-structured timeline with per-beat capture format and VO binding key",
        "zh-CN": "按节拍结构编写的时间线，每拍含机位与 VO 绑定键"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "subject_identity",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Subject identity",
        "zh-CN": "人物身份特征"
      },
      "descriptions": {
        "en": "Face, hair, age impression and persona traits",
        "zh-CN": "面部、发型、年龄感、身份气质等特征"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "vo_tone",
      "type": "string",
      "required": true,
      "examples": [
        "平静、亲密、不完美，像私密的自我倾诉"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "VO tone",
        "zh-CN": "旁白语气"
      },
      "descriptions": {
        "en": "Voiceover tone and performance requirement",
        "zh-CN": "旁白的语气与表演要求"
      },
      "sensitivity": "public"
    },
    {
      "name": "voiceover_script",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 16384,
      "labels": {
        "en": "Voiceover script",
        "zh-CN": "旁白脚本"
      },
      "descriptions": {
        "en": "VO lines with beat binding keys; preserved verbatim after render",
        "zh-CN": "逐句 VO 文本与节拍绑定键；渲染后逐字保留"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "wardrobe_and_accessories",
      "type": "string",
      "required": true,
      "min_length": 4,
      "max_length": 4096,
      "labels": {
        "en": "Wardrobe and accessories",
        "zh-CN": "服装与配饰"
      },
      "descriptions": {
        "en": "Full outfit and accessory list",
        "zh-CN": "全套服装与配饰清单"
      },
      "sensitivity": "public"
    }
  ]
}
