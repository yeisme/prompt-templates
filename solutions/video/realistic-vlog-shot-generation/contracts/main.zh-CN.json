{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "video",
  "solution_id": "realistic-vlog-shot-generation",
  "version": "1.0.0",
  "role": "main",
  "locale": "zh-CN",
  "template_path": "solutions/video/realistic-vlog-shot-generation/prompts/main.zh-CN.md",
  "template_digest": "sha256:4458e7a1060464ab5ae4062c39e5015fa897808e8046282ae94a5e000c86aee6",
  "digest": "sha256:4a2271a475e4e6b310d2e5e67be225efea8613590047f3ad8a95fb6f5e009a53",
  "license": "internal",
  "permissions": [
    "execute_requires_review",
    "inspect",
    "preview"
  ],
  "inputs": [
    {
      "name": "aspect_ratio",
      "type": "enum",
      "default": "16:9",
      "enum": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "labels": {
        "en": "Aspect ratio",
        "zh-CN": "画幅比例"
      },
      "descriptions": {
        "en": "Output aspect ratio",
        "zh-CN": "输出视频画幅"
      },
      "sensitivity": "public"
    },
    {
      "name": "audio_design",
      "type": "string",
      "required": true,
      "examples": [
        "自然风声、海浪、鸟鸣、脚步、自行车、街区环境声、纸张摩擦与真实笑声"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Audio design",
        "zh-CN": "声音设计"
      },
      "descriptions": {
        "en": "Ambience and action sound list",
        "zh-CN": "环境声与动作声清单"
      },
      "sensitivity": "public"
    },
    {
      "name": "audio_exclusions",
      "type": "string",
      "required": true,
      "examples": [
        "无音乐、旁白、字幕、标题、Logo 或水印"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Audio prohibitions",
        "zh-CN": "声音禁止项"
      },
      "descriptions": {
        "en": "Banned audio elements",
        "zh-CN": "禁止的声音元素"
      },
      "sensitivity": "public"
    },
    {
      "name": "camera_exclusions",
      "type": "string",
      "required": true,
      "examples": [
        "无稳定器、无人机、慢动作与精致商业广告质感"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Camera prohibitions",
        "zh-CN": "拍摄禁止项"
      },
      "descriptions": {
        "en": "Banned camera techniques",
        "zh-CN": "禁止的拍摄手法"
      },
      "sensitivity": "public"
    },
    {
      "name": "camera_imperfections",
      "type": "string",
      "required": true,
      "examples": [
        "构图不完美、自然晃动、自动对焦犹豫、曝光漂移、运动模糊、数码噪点与压缩痕迹"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Camera imperfections",
        "zh-CN": "不完美质感"
      },
      "descriptions": {
        "en": "Authentic capture flaws that must be preserved",
        "zh-CN": "必须保留的真实拍摄瑕疵"
      },
      "sensitivity": "public"
    },
    {
      "name": "camera_style",
      "type": "string",
      "required": true,
      "examples": [
        "朋友手持老款消费级相机拍摄"
      ],
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Camera style",
        "zh-CN": "拍摄风格"
      },
      "descriptions": {
        "en": "Operator and device character, e.g. a friend with an old consumer camera",
        "zh-CN": "拍摄者与设备气质，如朋友持老款家用机"
      },
      "sensitivity": "public"
    },
    {
      "name": "character_ref",
      "type": "string",
      "regex": "^@[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$",
      "min_length": 0,
      "max_length": 256,
      "labels": {
        "en": "Character asset ref",
        "zh-CN": "人物资产引用"
      },
      "descriptions": {
        "en": "Registered character asset @-reference; required when an asset exists",
        "zh-CN": "已登记人物资产的 @ 引用；有资产时必填"
      },
      "sensitivity": "public"
    },
    {
      "name": "consistency_lock",
      "type": "string",
      "required": true,
      "examples": [
        "全片保持完全一致的身份、服装、发型、比例与配饰"
      ],
      "min_length": 10,
      "max_length": 2048,
      "labels": {
        "en": "Consistency lock",
        "zh-CN": "一致性锁定"
      },
      "descriptions": {
        "en": "Non-negotiable identity/outfit/hairstyle/proportion/accessory lock",
        "zh-CN": "全片不可放宽的身份/服装/发型/比例/配饰锁定声明"
      },
      "sensitivity": "public"
    },
    {
      "name": "duration_s",
      "type": "integer",
      "required": true,
      "default": 30,
      "examples": [
        30
      ],
      "min": 5,
      "max": 120,
      "labels": {
        "en": "Duration (s)",
        "zh-CN": "总时长（秒）"
      },
      "descriptions": {
        "en": "Total duration; the timeline must cover it continuously",
        "zh-CN": "视频总时长，时间线序列必须连续覆盖"
      },
      "sensitivity": "public"
    },
    {
      "name": "ending_directive",
      "type": "string",
      "examples": [
        "29.5秒硬切黑场"
      ],
      "min_length": 0,
      "max_length": 2048,
      "labels": {
        "en": "Ending directive",
        "zh-CN": "结尾指令"
      },
      "descriptions": {
        "en": "How the video ends, e.g. hard cut to black timing",
        "zh-CN": "结尾执行方式，如硬切黑场时间"
      },
      "sensitivity": "public"
    },
    {
      "name": "final_feel",
      "type": "string",
      "required": true,
      "examples": [
        "朋友无意间捕捉到的美好但普通的瞬间——亲密、不完美、自然、真实"
      ],
      "min_length": 10,
      "max_length": 2048,
      "labels": {
        "en": "Final feel",
        "zh-CN": "最终气质"
      },
      "descriptions": {
        "en": "Overall feel declaration of the final footage",
        "zh-CN": "成片整体气质声明"
      },
      "sensitivity": "public"
    },
    {
      "name": "footage_style",
      "type": "string",
      "required": true,
      "examples": [
        "ultra-realistic home video"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Footage style",
        "zh-CN": "影像风格声明"
      },
      "descriptions": {
        "en": "Overall footage style declaration",
        "zh-CN": "整体影像气质声明，如超写实家用录像"
      },
      "sensitivity": "public"
    },
    {
      "name": "negative_prompts",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 8192,
      "labels": {
        "en": "Negative prompts",
        "zh-CN": "负面提示词"
      },
      "descriptions": {
        "en": "Negative constraint list; template defaults are merged",
        "zh-CN": "负面约束清单；模板内置默认负面项会并入"
      },
      "sensitivity": "public"
    },
    {
      "name": "realism_rules",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Realism rules",
        "zh-CN": "写实约束"
      },
      "descriptions": {
        "en": "Physics, material, lighting and anatomy realism requirements",
        "zh-CN": "物理、材质、光影、解剖等写实要求"
      },
      "sensitivity": "public"
    },
    {
      "name": "resolution",
      "type": "enum",
      "default": "1080p",
      "enum": [
        "720p",
        "1080p",
        "4K"
      ],
      "labels": {
        "en": "Resolution",
        "zh-CN": "分辨率"
      },
      "descriptions": {
        "en": "Output video resolution",
        "zh-CN": "输出视频分辨率"
      },
      "sensitivity": "public"
    },
    {
      "name": "scenario_summary",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 2048,
      "labels": {
        "en": "Scenario summary",
        "zh-CN": "场景梗概"
      },
      "descriptions": {
        "en": "One-line summary of who does what where",
        "zh-CN": "一句话说明谁在哪里做什么"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "sequence_beats",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 65536,
      "labels": {
        "en": "Timeline beats",
        "zh-CN": "时间线序列"
      },
      "descriptions": {
        "en": "Beat-structured timeline covering the whole duration",
        "zh-CN": "按节拍结构编写的时间线，连续覆盖全片"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "setting_desc",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Setting description",
        "zh-CN": "场景描述"
      },
      "descriptions": {
        "en": "Authentic environment details",
        "zh-CN": "真实感场景的环境细节"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "setting_exclusions",
      "type": "string",
      "required": true,
      "examples": [
        "无品牌、地标、广告与摆拍人群"
      ],
      "min_length": 4,
      "max_length": 2048,
      "labels": {
        "en": "Setting exclusions",
        "zh-CN": "场景排除项"
      },
      "descriptions": {
        "en": "Elements banned from the setting",
        "zh-CN": "场景中禁止出现的元素"
      },
      "sensitivity": "public"
    },
    {
      "name": "subject_identity",
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 4096,
      "labels": {
        "en": "Subject identity",
        "zh-CN": "人物身份特征"
      },
      "descriptions": {
        "en": "Face, hair, age impression and other identity traits",
        "zh-CN": "面部、发型、年龄感等身份特征描述"
      },
      "sensitivity": "sensitive"
    },
    {
      "name": "wardrobe_and_accessories",
      "type": "string",
      "required": true,
      "examples": [
        "象牙白oversize亚麻衬衫、雾蓝吊带、沙色长裤、白色运动鞋、棕色斜挎包、银色耳环与手表"
      ],
      "min_length": 4,
      "max_length": 4096,
      "labels": {
        "en": "Wardrobe and accessories",
        "zh-CN": "服装与配饰"
      },
      "descriptions": {
        "en": "Full outfit and accessory list",
        "zh-CN": "全套服装与配饰清单"
      },
      "sensitivity": "public"
    }
  ]
}
