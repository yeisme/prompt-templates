{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "writing",
  "solution_id": "revision-assistant",
  "version": "1.0.0",
  "role": "main",
  "locale": "en",
  "template_path": "solutions/writing/revision-assistant/prompts/main.en.md",
  "template_digest": "sha256:3cb11c26fd335bbfca19a7f6b605ea9f7fdbae6be68df4ac82518b07fc531978",
  "digest": "sha256:deff9e0e919f5c2d3da742f20b77a717352af6340d5502cb6bf9a841f9a58880",
  "license": "internal",
  "permissions": [
    "execute_requires_review",
    "preview"
  ],
  "inputs": [
    {
      "name": "audience",
      "type": "string",
      "default": "general reader",
      "labels": {
        "en": "Target reader",
        "zh-CN": "目标读者"
      }
    },
    {
      "name": "constraints",
      "type": "string",
      "default": "preserve facts, names, numbers, quotations, and necessary qualifications",
      "labels": {
        "en": "Revision constraints",
        "zh-CN": "修订约束"
      }
    },
    {
      "name": "revision_goal",
      "type": "string",
      "required": true,
      "labels": {
        "en": "Revision goal",
        "zh-CN": "修订目标"
      },
      "descriptions": {
        "en": "The concrete outcome required from this revision",
        "zh-CN": "本次修订要解决的具体问题"
      }
    },
    {
      "name": "source_text",
      "type": "string",
      "required": true,
      "labels": {
        "en": "Source text",
        "zh-CN": "待修订文本"
      },
      "descriptions": {
        "en": "The complete text to revise",
        "zh-CN": "需要修订的完整原文"
      },
      "sensitivity": "sensitive"
    }
  ]
}
