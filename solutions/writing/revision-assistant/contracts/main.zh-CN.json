  "inputs": [
    {
      "name": "audience",
      "type": "string",
      "default": "一般读者",
      "labels": {
        "en": "Target reader",
        "zh-CN": "目标读者"
      }
    },
    {
      "name": "constraints",
      "type": "string",
      "default": "保留事实、专名、数字、引用和必要限定",
      "labels": {
        "en": "Revision constraints",
        "zh-CN": "修订约束"
      }
    },
    {
      "name": "revision_goal",
      "type": "string",
      "required": true,
      "labels": {
        "en": "Revision goal",
        "zh-CN": "修订目标"
      },
      "descriptions": {
        "en": "The concrete outcome required from this revision",
        "zh-CN": "本次修订要解决的具体问题"
      }
    },
    {
      "name": "source_text",
      "type": "string",
      "required": true,
      "labels": {
        "en": "Source text",
        "zh-CN": "待修订文本"
      },
      "descriptions": {
        "en": "The complete text to revise",
        "zh-CN": "需要修订的完整原文"
      },
      "sensitivity": "sensitive"
    }
  ]
