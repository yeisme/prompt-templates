{
  "schema_version": "promptrepo.template-contract.v0.1",
  "package_id": "writing",
  "solution_id": "revision-assistant",
  "version": "1.0.0",
  "role": "main",
  "locale": "zh-CN",
  "template_path": "solutions/writing/revision-assistant/prompts/main.zh-CN.md",
